{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/blogs",
        "destination": "/blog",
        "type": 301
      },
      {
        "source": "/local-ai-bookkeeping-dominance",
        "destination": "/blog.html",
        "type": 301
      },
      {
        "source": "/local-ai-bookkeeping-dominance.html",
        "destination": "/blog.html",
        "type": 301
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}